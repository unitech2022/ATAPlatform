{
  "ConnectionStrings": {
    "Default": "Server=localhost;Port=3306;Database=ata;User=ata;Password=ata;"
  },
  "Jwt": {
    "Issuer": "ata-platform",
    "Audience": "ata-clients",
    "Key": "",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 30
  },
  "Otp": {
    "DevMode": false,
    "Digits": 4,
    "ExpiryMinutes": 5,
    "MaxAttempts": 5,
    "ResendAfterSeconds": 60,
    "MaxRequestsPerWindow": 3,
    "WindowMinutes": 10
  },
  "RateLimiting": {
    "OtpPerIpPerHour": 10
  },
  "Storage": {
    "Root": "./storage"
  },
  "Cors": {
    "Origins": []
  },
  "Payments": {
    "SandboxEnabled": false,
    "MinTopup": 10,
    "MaxTopup": 5000
  },
  "Trips": {
    "FreeWaitingMinutes": 3,
    "ArrivalRadiusMeters": 300,
    "PinMaxAttempts": 5,
    "ScheduledLeadMinutes": 15
  },
  "Matching": {
    "Enabled": true,
    "RadiusMeters": 5000,
    "MaxRadiusMeters": 12000,
    "RadiusStepMeters": 2500,
    "OfferTimeoutSeconds": 20,
    "SearchTimeoutSeconds": 120,
    "MaxCandidates": 8,
    "AllowUpgrade": false,
    "PollIntervalSeconds": 2,
    "LocationMaxAgeSeconds": 300
  },
  "Pricing": {
    "OfferMinPercent": 70,
    "OfferMaxPercent": 130,
    "QuoteExpiryMinutes": 5,
    "UtcOffsetMinutes": 180
  },
  "Demand": {
    "Enabled": true,
    "IntervalSeconds": 60,
    "SnapshotMaxAgeMinutes": 20,
    "SnapshotRetentionHours": 48
  },
  "Realtime": {
    "LiveSnapshotEnabled": true,
    "LiveSnapshotSeconds": 5
  },
  "Admin": {
    "Username": "admin",
    "Password": "Admin@12345",
    "PhoneNumber": "+966500000000"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
