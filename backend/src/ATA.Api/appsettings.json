{
  "ConnectionStrings": {
    "Default": "Server=localhost;Port=3306;Database=ata;User=ata;Password=ata;"
  },
  "Jwt": {
    "Issuer": "ata-platform",
    "Audience": "ata-clients",
    "Key": "",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 30
  },
  "Otp": {
    "DevMode": false,
    "Digits": 4,
    "ExpiryMinutes": 5,
    "MaxAttempts": 5,
    "ResendAfterSeconds": 60,
    "MaxRequestsPerWindow": 3,
    "WindowMinutes": 10
  },
  "RateLimiting": {
    "OtpPerIpPerHour": 10
  },
  "Storage": {
    "Root": "./storage"
  },
  "Cors": {
    "Origins": []
  },
  "Payments": {
    "Provider": "sandbox",
    "SandboxEnabled": false,
    "SandboxSkipAuthorization": false,
    "CardAuthorizeOnRequest": true,
    "AuthBufferPercent": 30,
    "ActionTimeoutSeconds": 300,
    "GatewayTimeoutSeconds": 15,
    "CaptureTimeoutSeconds": 10,
    "CaptureMaxAttempts": 5,
    "MinTopup": 10,
    "MaxTopup": 5000,
    "MaxTopupPerDay": 10000,
    "MaxCardsPerUser": 5,
    "RefundAutoApproveLimit": 50,
    "BlockOnOutstandingBalance": true,
    "PublicBaseUrl": "https://api.ata.sa",
    "DefaultReturnUrl": "ata://payments/return",
    "JobsEnabled": true,
    "Sandbox": {
      "WebhookSecret": "sandbox-webhook-secret",
      "SignatureHeader": "X-Sandbox-Signature",
      "PublishableKey": "pk_test_sandbox"
    },
    "Moyasar": {
      "BaseUrl": "https://api.moyasar.com",
      "PublishableKey": "",
      "SecretKey": "",
      "WebhookSecret": "",
      "SignatureHeader": "X-Moyasar-Signature",
      "ApplePayMerchantId": ""
    }
  },
  "Trips": {
    "FreeWaitingMinutes": 3,
    "ArrivalRadiusMeters": 300,
    "PinMaxAttempts": 5,
    "ScheduledLeadMinutes": 15
  },
  "Matching": {
    "Enabled": true,
    "RadiusMeters": 5000,
    "MaxRadiusMeters": 12000,
    "RadiusStepMeters": 2500,
    "OfferTimeoutSeconds": 20,
    "SearchTimeoutSeconds": 120,
    "MaxCandidates": 8,
    "AllowUpgrade": false,
    "PollIntervalSeconds": 2,
    "LocationMaxAgeSeconds": 300
  },
  "Pricing": {
    "OfferMinPercent": 70,
    "OfferMaxPercent": 130,
    "QuoteExpiryMinutes": 5,
    "UtcOffsetMinutes": 180
  },
  "Demand": {
    "Enabled": true,
    "IntervalSeconds": 60,
    "SnapshotMaxAgeMinutes": 20,
    "SnapshotRetentionHours": 48
  },
  "Realtime": {
    "LiveSnapshotEnabled": true,
    "LiveSnapshotSeconds": 5
  },
  "Payouts": {
    "MinAmount": 100,
    "MaxCashDebt": 500,
    "AutoApprove": false,
    "AutoApproveLimit": 1000
  },
  "Settlements": {
    "PeriodDays": 7,
    "AutoGenerate": true,
    "AutoCreatePayouts": false
  },
  "OneSignal": {
    "Enabled": false,
    "AppId": "",
    "RestApiKey": "",
    "ApiBaseUrl": "https://api.onesignal.com",
    "TimeoutSeconds": 10,
    "AndroidChannels": {
      "trips": "",
      "offers": "",
      "safety": "",
      "wallet": "",
      "promotions": "",
      "system": ""
    }
  },
  "Sms": {
    "Provider": "logging",
    "Sandbox": true,
    "SenderName": "ATA",
    "TimeoutSeconds": 10,
    "Unifonic": {
      "BaseUrl": "https://el.cloud.unifonic.com",
      "AppSid": ""
    },
    "Taqnyat": {
      "BaseUrl": "https://api.taqnyat.sa",
      "BearerToken": ""
    }
  },
  "Notifications": {
    "WorkerEnabled": true,
    "JobsEnabled": true,
    "WorkerPollSeconds": 5,
    "MaxAttempts": 5,
    "PushBatchSize": 2000,
    "CampaignPushPerMinute": 60,
    "CampaignPollSeconds": 30,
    "DocumentExpiryOffsetsDays": [
      30,
      7,
      1
