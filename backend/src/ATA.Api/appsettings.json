  "Admin": {
    "Username": "admin",
    "Password": "Admin@12345",
    "PhoneNumber": "+966500000000"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
