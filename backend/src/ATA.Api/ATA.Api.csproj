<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>ATA.Api</RootNamespace>
    <UserSecretsId>ata-platform-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.10" />
    <!-- F19 invoice PDFs: QuestPDF (Community license, see README "Corporate invoices") with RTL shaping; QRCoder (MIT) builds the ZATCA TLV QR matrix. -->
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- IBM Plex Sans Arabic (SIL OFL 1.1) embedded so PDFs render Arabic without system fonts. -->
    <EmbeddedResource Include="Modules\Corporate\Fonts\*.ttf" LogicalName="ATA.Fonts.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ATA.Infrastructure\ATA.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ATA.Tests" />
  </ItemGroup>

</Project>
