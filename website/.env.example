# Base URL of the ATA backend API (no trailing slash).
VITE_API_BASE_URL=http://localhost:5000/api/v1
# Corporate sales contact on /business (mailto target; WhatsApp button hidden when empty).
VITE_BUSINESS_EMAIL=business@ata.sa
VITE_BUSINESS_WHATSAPP=
# Place search/reverse geocoding for corporate bookings (OSM Nominatim by default; empty disables it).
VITE_GEOCODER_URL=https://nominatim.openstreetmap.org
